# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Chave secreta (Project Settings → API Keys → Secret keys). Só no servidor: NUNCA com prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Notificações push (gerar com: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:teamedcycling@gmail.com
# Emails de aviso (a mesma App Password do Gmail usada no SMTP do Supabase)
GMAIL_USER=teamedcycling@gmail.com
GMAIL_APP_PASSWORD=
# Protege o lembrete diário (qualquer texto longo e aleatório)
CRON_SECRET=
# Endereço público do site (para os links dos emails e convites)
NEXT_PUBLIC_SITE_URL=https://edcycling-website.vercel.app
